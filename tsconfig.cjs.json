{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-cjs",
    "declaration": true,
    "declarationMap": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/git/**/*.ts",
    "src/config/**/*.ts",
    "src/browser/**/*.ts",
    "src/index.ts"
  ],
  "exclude": [
    "src/vite/**",
    "src/cli/**",
    "src/site/**",
    "src/pages/**",
    "node_modules",
    "dist",
    "dist-cjs"
  ]
}
