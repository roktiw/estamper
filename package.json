{
  "name": "estamper",
  "version": "0.1.0",
  "description": "Human-readable build stamps for web apps, staging, QA and screenshots.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "estamper": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser/index.js",
    "./vite": "./dist/vite/index.js",
    "./config": "./dist/config/index.js"
  },
  "files": [
    "dist",
    "estamper.config.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "site:dev": "astro dev",
    "site:build": "astro build",
    "site:preview": "astro preview"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.1",
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.19.0",
    "astro": "^7.0.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "build",
    "version",
    "stamp",
    "badge",
    "git",
    "github",
    "commit",
    "deployment",
    "vite",
    "qa",
    "debug",
    "frontend",
    "web-games",
    "release"
  ]
}
