<script>
  const mountFallbackBadge = (data) => {
    if (!data?.stamp || document.querySelector('[data-estamper-dogfood]')) return;
    const badge = document.createElement('button');
    badge.type = 'button';
    badge.dataset.estamperDogfood = 'true';
    badge.textContent = data.stamp;
    badge.title = 'Estamper dogfooding stamp';
    badge.style.cssText = 'position:fixed;right:1rem;bottom:1rem;z-index:9999;max-width:min(38rem,calc(100vw - 2rem));border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:.55rem .8rem;background:rgba(15,23,42,.9);color:#f8fafc;font:12px ui-monospace,SFMono-Regular,Consolas,monospace;box-shadow:0 18px 50px rgba(0,0,0,.35);cursor:pointer;overflow-wrap:anywhere';
    badge.addEventListener('click', () => navigator.clipboard?.writeText(data.stamp).catch(() => undefined));
    document.body.append(badge);
  };

  const wireCopyButton = (data) => {
    document.querySelector('#copy-site-stamp')?.addEventListener('click', () => navigator.clipboard?.writeText(data.stamp).catch(() => undefined));
  };

  fetch('/estamper.json')
    .then((res) => (res.ok ? res.json() : null))
    .then((data) => {
      if (!data?.stamp) return;
      wireCopyButton(data);
      import('../browser/index.js')
        .then(({ mountEstamper }) => mountEstamper({
          stamp: data.stamp,
          details: data.parts,
          position: 'bottom-right',
          theme: 'auto',
          jsonUrl: '/estamper.json',
          commitUrl: data.parts?.commit ? `https://github.com/roktiw/estamper-priv/commit/${data.parts.commit}` : undefined,
        }))
        .catch(() => mountFallbackBadge(data));
    })
    .catch(() => undefined);
</script>
